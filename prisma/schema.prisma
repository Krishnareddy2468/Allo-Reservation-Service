// Reservation service schema.
// Stock is split into total vs. reserved so "available" can be derived
// at read time and updated atomically without a separate table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  priceCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockLevels  StockLevel[]
  reservations Reservation[]
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels  StockLevel[]
  reservations Reservation[]
}

model StockLevel {
  id            String   @id @default(cuid())
  productId     String
  warehouseId   String
  totalUnits    Int      @default(0)
  reservedUnits Int      @default(0)
  updatedAt     DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // One stock row per (product, warehouse) pair so the atomic
  // UPDATE in the reserve path can target a single row.
  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

model Reservation {
  id          String            @id @default(cuid())
  productId   String
  warehouseId String
  sessionId   String
  quantity    Int
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // (status, expiresAt) powers the expiry sweeper:
  // WHERE status = 'PENDING' AND expiresAt < now().
  @@index([status, expiresAt])
  // sessionId index supports "my reservations" lookups for the cookie-based identity.
  @@index([sessionId])
  @@index([productId, warehouseId])
}

# Neon Postgres
# Get these from your Neon project dashboard → Connection Details
# Use the "Pooled" connection for DATABASE_URL and "Direct" for DIRECT_URL
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Upstash Redis
# Get these from your Upstash console → Redis database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# Cron secret — any random string, e.g.: openssl rand -hex 32
# Set the same value in Vercel environment variables and in vercel.json's
# Authorization header if you customise the cron request headers.
CRON_SECRET=your-random-secret-here
